{
  "lines": [
    {
      "speaker": "NPC",
      "npcName": "[ 텃밭 아주머니 춘자 ]",
      "text": "어머 총각, 이게 얼마만이여.",
      "presentation": "Cinematic",
      "portrait": "Portraits/portrait_C01",
      "background": "Backgrounds/BG_farm"
    },
    {
      "speaker": "Player",
      "text": "아유 안녕하세요.",
      "presentation": "Cinematic",
      "portrait": "Portraits/portrait_C01",
      "background": "Backgrounds/BG_farm"
    },
    {
      "speaker": "Player",
      "text": "오랫만에 좀 나와봤어요.",
      "presentation": "Cinematic",
      "portrait": "Portraits/portrait_C01",
      "background": "Backgrounds/BG_farm"
    },
    {
      "speaker": "Player",
      "text": "오늘도 밭일하세요?",
      "presentation": "Cinematic",
      "portrait": "Portraits/portrait_C01",
      "background": "Backgrounds/BG_farm"
    },
    {
      "speaker": "NPC",
      "npcName": "[ 텃밭 아주머니 춘자 ]",
      "text": "나야 맨날 밭에 나와있지 뭐.",
      "presentation": "Cinematic",
      "portrait": "Portraits/portrait_C01",
      "background": "Backgrounds/BG_farm"
    },
    {
      "speaker": "NPC",
      "npcName": "[ 텃밭 아주머니 춘자 ]",
      "text": "혼자살면 다 혼자 이래 해야댜.",
      "presentation": "Cinematic",
      "portrait": "Portraits/portrait_C01",
      "background": "Backgrounds/BG_farm"
    },
    {
      "speaker": "NPC",
      "npcName": "[ 텃밭 아주머니 춘자 ]",
      "text": "이나이먹고도 적적해 죽겄어.",
      "presentation": "Cinematic",
      "portrait": "Portraits/portrait_C01",
      "background": "Backgrounds/BG_farm"
    },
    {
      "speaker": "NPC",
      "npcName": "[ 텃밭 아주머니 춘자 ]",
      "text": "젊은이가 좀 도와주면 좋겠는데 괜찮은감?",
      "presentation": "Cinematic",
      "portrait": "Portraits/portrait_C02",
      "background": "Backgrounds/BG_farm"
    },
    {
      "speaker": "Player",
      "text": "(오..?)",
      "presentation": "Cinematic",
      "portrait": "Portraits/portrait_C02",
      "background": "Backgrounds/BG_farm"
    },
    {
      "speaker": "Player",
      "text": "(당근을 손가락만으로 뽑아볼까?)",
      "presentation": "Cinematic",
      "portrait": "Portraits/portrait_C02",
      "background": "Backgrounds/BG_farm"
    },
    {
      "speaker": "Player",
      "text": "(진짜 좋은 기회다. 훈련 많이 될거야.)",
      "presentation": "Cinematic",
      "portrait": "Portraits/portrait_C02",
      "background": "Backgrounds/BG_farm"
    },
    {
      "speaker": "Player",
      "text": "물론이죠!",
      "presentation": "Cinematic",
      "portrait": "Portraits/portrait_C02",
      "background": "Backgrounds/BG_farm",
      "questId": "C001",
      "questAction": "Accept"
    }
  ]
}