      standing: {fileID: 0}
      presentation: 1
  - quest: {fileID: 0}
    questAction: 0
    speaker: 0
    npcName: 
    text: "\uADF8\uB798\uC694 \uD568 \uBCF4\uC2DC\uC8E0."
