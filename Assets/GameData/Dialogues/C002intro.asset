      standing: {fileID: 0}
      presentation: 1
  - quest: {fileID: 0}
    questAction: 0
    speaker: 1
    npcName: 
    text: "???: \uC0AC\uB77C\uC838\uB77C! \uC774 \uAC00\uC9DC!"
