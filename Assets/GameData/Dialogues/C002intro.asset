    speaker: 1
    npcName: "[ \uD143\uBC2D \uC544\uC8FC\uBA38\uB2C8 \uCD98\uC790 ]"
    text: "\uB108\uBB34 \uD669\uB2F9\uD574\uC11C \uC815\uC2E0\uC774 \uC5C6\uC5B4\uC57C."
