  lines:
  - quest: {fileID: 0}
    questAction: 0
    speaker: 0
    npcName: 
    text: "\uC798 \uC9C0\uB0B4\uC168\uC5B4\uC694, \uC544\uC8FC\uBA38\uB2C8?"
    visual:
      portrait: {fileID: 21300000, guid: ea6b213da0c9248f4b66fa6c5fc07e1e, type: 3}
      background: {fileID: 21300000, guid: e36bc9c40b8e3452ba748f6717679cfa, type: 3}
      standing: {fileID: 0}
      presentation: 1
  - quest: {fileID: 0}
    questAction: 0
    speaker: 1
    npcName: "[ \uD143\uBC2D \uC544\uC8FC\uBA38\uB2C8 \uCD98\uC790 ]"
    text: "\uC798 \uC654\uB124, \uCD1D\uAC01!"
