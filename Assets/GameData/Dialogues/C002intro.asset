      portrait: {fileID: 21300000, guid: ea6b213da0c9248f4b66fa6c5fc07e1e, type: 3}
      background: {fileID: 21300000, guid: e36bc9c40b8e3452ba748f6717679cfa, type: 3}
      standing: {fileID: 0}
      presentation: 1
  - quest: {fileID: 0}
    questAction: 0
    speaker: 1
    npcName: "[ \uD143\uBC2D \uC544\uC8FC\uBA38\uB2C8 \uCD98\uC790 ]"
    text: "\uBCF4\uC5EC\uC904 \uD14C\uB2C8 \uB530\uB77C\uC640\uC11C \uC9C1\uC811
