  m_Script: {fileID: 11500000, guid: 65305491a1230404680fe2db3d6b994b, type: 3}
  m_Name: bedroomIntro
  m_EditorClassIdentifier: 
  lines:
  - quest: {fileID: 0}
    questAction: 0
    speaker: 1
    npcName: 
    text: "\uD560\uC9D3\uC5C6\uB294 \uB9C8\uC744\uC758 \uC544\uCE68\uC774 \uBC1D\uC558\uC5B4\uC694."
    visual:
      portrait: {fileID: 0}
      background: {fileID: 21300000, guid: 16290b04a315b4fd1b6af3522562eb62, type: 3}
      standing: {fileID: 0}
      presentation: 2
  - quest: {fileID: 0}
    questAction: 0
    speaker: 1
    npcName: 
    text: "\uC5EC\uB290 \uB0A0\uACFC \uAC19\uC774 \uB2F9\uC2E0\uC740 \uD587\uC0B4\uC5D0
      \uB208\uC744 \uB5B4\uC2B5\uB2C8\uB2E4."
    visual:
      portrait: {fileID: 0}
      background: {fileID: 21300000, guid: 16290b04a315b4fd1b6af3522562eb62, type: 3}
      standing: {fileID: 0}
      presentation: 2
  - quest: {fileID: 0}
    questAction: 0
    speaker: 1
    npcName: 
    text: "\uB35C \uD480\uB9B0\uB208\uC73C\uB85C \uBCF4\uB294 \uCC3D \uBC16\uC740
      \uD654\uCC3D\uD55C \uB0A0\uC785\uB2C8\uB2E4."
    visual:
      portrait: {fileID: 0}
      background: {fileID: 21300000, guid: 16290b04a315b4fd1b6af3522562eb62, type: 3}
      standing: {fileID: 0}
      presentation: 2
  - quest: {fileID: 0}
    questAction: 0
    speaker: 1
    npcName: 
    text: "\uC624\uB298\uB3C4 \uC5B4\uC81C\uCC98\uB7FC \uB530\uBD84\uD55C \uD558\uB8E8\uAC00
      \uB420 \uAC70\uB77C\uB294 \uC0DD\uAC01\uC5D0,"
    visual:
      portrait: {fileID: 0}
      background: {fileID: 21300000, guid: 16290b04a315b4fd1b6af3522562eb62, type: 3}
      standing: {fileID: 0}
      presentation: 2
  - quest: {fileID: 0}
    questAction: 0
    speaker: 1
    npcName: 
    text: "\uC18D\uC740 \uD479 \uB298\uC5B4\uC9C0\uACE0, \uB098\uB978\uD558\uAC8C
      \uBA4D\uC744 \uB54C\uB9BD\uB2C8\uB2E4."
    visual:
      portrait: {fileID: 0}
      background: {fileID: 21300000, guid: 16290b04a315b4fd1b6af3522562eb62, type: 3}
      standing: {fileID: 0}
      presentation: 2
  - quest: {fileID: 0}
    questAction: 0
    speaker: 1
    npcName: 
    text: "\uC55E\uC73C\uB85C \uC77C\uC5B4\uB0A0 \uC77C\uC740 \uC0C1\uC0C1\uB3C4
      \uBABB\uD55C \uCC44\uB85C \uB9D0\uC774\uC5D0\uC694."
    visual:
      portrait: {fileID: 0}
      background: {fileID: 21300000, guid: 16290b04a315b4fd1b6af3522562eb62, type: 3}
      standing: {fileID: 0}
      presentation: 2
  - quest: {fileID: 0}
    questAction: 0
    speaker: 1
    npcName: 
    text: "\uAC70\uC6B8\uC744 \uC9C0\uB098\uB2C8 \uC6EC\uAC78?"
    visual:
      portrait: {fileID: 0}
      background: {fileID: 21300000, guid: 83580cc54475f4e019af673b871e4256, type: 3}
      standing: {fileID: 0}
      presentation: 2
  - quest: {fileID: 0}
    questAction: 0
    speaker: 1
    npcName: 
    text: "\uD558\uB8E8\uC544\uCE68\uC5D0 \uB09C\uB370\uC5C6\uC774,"
    visual:
      portrait: {fileID: 0}
      background: {fileID: 21300000, guid: 83580cc54475f4e019af673b871e4256, type: 3}
      standing: {fileID: 0}
      presentation: 2
  - quest: {fileID: 0}
    questAction: 0
    speaker: 1
    npcName: 
    text: "\uC5BC\uAD74\uC5D0 \uD07C\uC9C0\uB9C9\uD55C \uD138\uC774 \uC790\uB77C\uB098
      \uC788\uB294\uAC8C \uC544\uB2C8\uACA0\uC5B4\uC694?"
    visual:
      portrait: {fileID: 0}
      background: {fileID: 21300000, guid: 83580cc54475f4e019af673b871e4256, type: 3}
      standing: {fileID: 0}
      presentation: 2
  - quest: {fileID: 0}
    questAction: 0
    speaker: 1
    npcName: 
    text: "\uC190\uC73C\uB85C \uC7A1\uC544 \uC2DC\uC6D0\uD558\uAC8C \uBF51\uC544\uBC84\uB9AC\uB824\uACE0
      \uD588\uC9C0\uB9CC,"
    visual:
      portrait: {fileID: 0}
      background: {fileID: 21300000, guid: 83580cc54475f4e019af673b871e4256, type: 3}
      standing: {fileID: 0}
      presentation: 2
  - quest: {fileID: 0}
    questAction: 0
    speaker: 1
    npcName: 
    text: "\uD138 \uC8FC\uBCC0\uB9CC \uBD80\uC5B4\uC624\uB974\uACE0 \uC804\uD600
      \uBF51\uD788\uC9C0\uAC00 \uC54A\uB124\uC694."
    visual:
      portrait: {fileID: 0}
      background: {fileID: 21300000, guid: 83580cc54475f4e019af673b871e4256, type: 3}
      standing: {fileID: 0}
      presentation: 2
  - quest: {fileID: 0}
    questAction: 0
    speaker: 1
    npcName: 
    text: "\uB2F9\uC2E0\uC740 \uADF8\uB9CC \uC624\uAE30\uAC00 \uC0DD\uACA8 \uD55C\uCC38
      \uB3D9\uC548 \uBAB0\uB450\uD588\uC5B4\uC694."
    visual:
      portrait: {fileID: 0}
      background: {fileID: 21300000, guid: 83580cc54475f4e019af673b871e4256, type: 3}
      standing: {fileID: 0}
      presentation: 2
  - quest: {fileID: 0}
    questAction: 0
    speaker: 1
    npcName: 
    text: "\uC190\uAC00\uB77D\uC740 \uC544\uD504\uACE0, \uBCFC\uC740 \uB530\uAC11\uACE0,
      \uBD80\uC5B4\uC624\uB974\uACE0,"
    visual:
      portrait: {fileID: 0}
      background: {fileID: 21300000, guid: 83580cc54475f4e019af673b871e4256, type: 3}
      standing: {fileID: 0}
      presentation: 2
  - quest: {fileID: 0}
    questAction: 0
    speaker: 1
    npcName: 
    text: "\uBB54\uC9C0 \uBAA8\uB97C \uC9C4\uBB3C\uAE4C\uC9C0 \uC0C8\uC5B4\uB098\uC624\uACE0
      \uC788\uACE0.."
    visual:
      portrait: {fileID: 0}
      background: {fileID: 21300000, guid: 83580cc54475f4e019af673b871e4256, type: 3}
      standing: {fileID: 0}
      presentation: 2
  - quest: {fileID: 0}
    questAction: 0
    speaker: 1
    npcName: 
    text: "..\uB2F5\uB2F5\uD558\uB2C8 \uC9DC\uC99D\uC774 \uCE58\uBC00\uC5B4 \uC624\uB985\uB2C8\uB2E4."
    visual:
      portrait: {fileID: 0}
      background: {fileID: 21300000, guid: 83580cc54475f4e019af673b871e4256, type: 3}
      standing: {fileID: 0}
      presentation: 2
  - quest: {fileID: 0}
    questAction: 0
    speaker: 1
    npcName: 
    text: "\uC774\uB300\uB85C\uB294 \uCC1D\uCC1D\uD574\uC11C \uAC00\uB9CC\uD788 \uC788\uC744
      \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    visual:
      portrait: {fileID: 0}
      background: {fileID: 21300000, guid: 63bd90042d40b41a4af825e16e5e1447, type: 3}
      standing: {fileID: 0}
      presentation: 2
  - quest: {fileID: 0}
    questAction: 0
    speaker: 1
    npcName: 
    text: "\uB2F9\uC2E0\uC740 \uC190\uAC00\uB77D\uC744 \uB2E8\uB828\uD558\uAE30\uB85C
      \uACB0\uC2EC\uD588\uC5B4\uC694."
    visual:
      portrait: {fileID: 0}
      background: {fileID: 21300000, guid: 63bd90042d40b41a4af825e16e5e1447, type: 3}
      standing: {fileID: 0}
      presentation: 2
  - quest: {fileID: 0}
    questAction: 0
    speaker: 1
    npcName: 
    text: "\uB354\uC6B1 \uAC15\uD574\uC9C4 \uC190\uAC00\uB77D\uC73C\uB85C \uC9C1\uC811,"
    visual:
      portrait: {fileID: 0}
      background: {fileID: 21300000, guid: 63bd90042d40b41a4af825e16e5e1447, type: 3}
      standing: {fileID: 0}
      presentation: 2
  - quest: {fileID: 0}
    questAction: 0
    speaker: 1
    npcName: 
    text: "\uC774 \uBE4C\uC5B4\uBA39\uAC8C \uD749\uD55C \uD138\uC744 \uBF51\uC544\uB0B4\uB9AC\uB77C
      \uB2E4\uC9D0\uD588\uC5B4\uC694."
    visual:
      portrait: {fileID: 0}
      background: {fileID: 21300000, guid: 63bd90042d40b41a4af825e16e5e1447, type: 3}
      standing: {fileID: 0}
      presentation: 2
  - quest: {fileID: 0}
    questAction: 0
    speaker: 1
    npcName: 
    text: "\uADF8\uB807\uAC8C \uC9D1\uC744 \uB098\uC11C\uAE30\uB85C \uD569\uB2C8\uB2E4."
    visual:
      portrait: {fileID: 0}
      background: {fileID: 21300000, guid: 63bd90042d40b41a4af825e16e5e1447, type: 3}
      standing: {fileID: 0}
      presentation: 2
  - quest: {fileID: 0}
    questAction: 0
    speaker: 1
    npcName: 
    text: "\uC0AC\uB78C\uB4E4\uC744 \uC704\uD574 \uBB50\uB4E0\uC9C0 \uBF51\uC544\uB0B4\uC8FC\uB294,"
    visual:
      portrait: {fileID: 0}
      background: {fileID: 21300000, guid: 63bd90042d40b41a4af825e16e5e1447, type: 3}
      standing: {fileID: 0}
      presentation: 2
  - quest: {fileID: 0}
    questAction: 0
    speaker: 1
    npcName: 
    text: "\uD560\uC9D3\uC5C6\uB294 \uB9C8\uC744\uC758 \uC601\uC6C5."
    visual:
      portrait: {fileID: 0}
      background: {fileID: 21300000, guid: 63bd90042d40b41a4af825e16e5e1447, type: 3}
      standing: {fileID: 0}
      presentation: 2
  - quest: {fileID: 0}
    questAction: 0
    speaker: 1
    npcName: 
    text: "\uD551\uAC70\uB9E8 \uC774\uC57C\uAE30\uC758 \uC2DC\uC791\uC774\uC5C8\uC2B5\uB2C8\uB2E4."
    visual:
      portrait: {fileID: 0}
      background: {fileID: 21300000, guid: 63bd90042d40b41a4af825e16e5e1447, type: 3}
      standing: {fileID: 0}
      presentation: 2
  - quest: {fileID: 0}
    questAction: 0
    speaker: 0
    npcName: 
    text: "\uBCFC\uC774 \uC880 \uCC1D\uCC1D\uD55C\uB370.."
    visual:
      portrait: {fileID: 0}
      background: {fileID: 0}
      standing: {fileID: 0}
      presentation: 0
  - quest: {fileID: 0}
    questAction: 0
    speaker: 0
    npcName: 
    text: "\uB610 \uC9C4\uBB3C\uC774 \uB098\uC654\uB294\uC9C0 \uBD10\uC57C\uACA0\uB294\uAC78."
    visual:
      portrait: {fileID: 0}
      background: {fileID: 0}
      standing: {fileID: 0}
      presentation: 0
